{
	"name": "website",
	"compatibility_date": "2026-09-22",
	"main": "worker/index.js",
	"assets": {
		"directory": "./",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "PRIVATE_MEDIA",
			"bucket_name": "flubzies-private"
		},
		{
			// Aljakun dev-build bug reports (worker/bug-report.js). Kept apart from PRIVATE_MEDIA, which the
			// team page lists and serves in full.
			"binding": "BUG_REPORTS",
			"bucket_name": "flubzies-bug-reports"
		}
	],
	// Secrets (wrangler secret put, never in this public repo): BUG_REPORT_TOKEN, RESEND_API_KEY.
	"ratelimits": [
		{
			"name": "BUG_REPORT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 3, "period": 60 }
		}
	]
}
